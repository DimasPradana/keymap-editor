# Backend env (gitignored). Isi nilai GitHub App setelah dibuat.
PORT=8080
ENABLE_GITHUB=true
GITHUB_APP_NAME=keymap-editor-dimas
GITHUB_APP_ID=<isi App ID>
GITHUB_APP_PRIVATE_KEY=<isi PEM lengkap, multiline>
GITHUB_CLIENT_ID=<isi Client ID>
GITHUB_CLIENT_SECRET=<isi Client Secret>
GITHUB_OAUTH_CALLBACK_URL=https://chocofi.pentabit.id/github/authorize
APP_BASE_URL=https://dimaspradana.github.io/keymap-editor
EOF
echo "created .env (root)"